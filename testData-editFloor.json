//Example JSON payload for editing a floor


run this in sql server to check test floor and position i used
 - select * from Floors where SiteId='Fairview werner'
 - select * from Positions where Project='Florida Werner Blue'


run in terminal

 curl -X POST http://localhost/floorPlan/api/controller/editFloorController.php \
 -H "Content-Type: application/json" \
 -d '[
   {
     "floorId": 524,
     "siteId": "Fairview werner",
     "dateValid": "2021-08-01",
     "name": "4F Edited",
     "comment": "Updated only floor 524 with new columns",
     "scenario": null,
     "Active": 0,
     "Date_inactive": null,
     "position": [
       {
         "row": 35,
         "col": 46,
         "tool": "Updated Chair",
         "color": "#ff6600",
         "tag": "Updated",
         "label": "New Label A",
         "assignId": "G",
         "project": "Florida Werner Edited with new columns",
         "shift": "PM"
       }
     ]
   }
 ]'

 run this in sql server to check changes:
 "select * from Floors where Id = '524'"


